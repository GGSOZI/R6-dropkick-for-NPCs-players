local function setSimRadius()
	pcall(function() player.MaximumSimulationRadius = SIM_RADIUS end)
	if sethiddenproperty then pcall(sethiddenproperty, player, "SimulationRadius", SIM_RADIUS) end
	if setsimulationradius then pcall(setsimulationradius, SIM_RADIUS, SIM_RADIUS) end
