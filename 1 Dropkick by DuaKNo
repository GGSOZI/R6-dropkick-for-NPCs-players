local function rotated(orig, rot)
	local p = orig.Position
	return CFrame.new(p) * rot * (CFrame.new(-p) * orig)
end

local function A(x, y, z)
	return CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0))
end

local function ease(kind, k)
	if kind == "out" then
		return 1 - (1 - k) ^ 3
	elseif kind == "in" then
		return k ^ 3
	elseif kind == "inout" then
		if k < 0.5 then return 4 * k ^ 3 end
		return 1 - (-2 * k + 2) ^ 3 / 2
	elseif kind == "snap" then
		local c1 = 1.2
		local c3 = c1 + 1
		return 1 + c3 * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
	elseif kind == "linear" then
		return k
	end
	return k * k * (3 - 2 * k)
end

local function channel(key, t)
	if t < 0 then t = 0 end
	local a, b = FRAMES[#FRAMES - 1], FRAMES[#FRAMES]
	for i = 1, #FRAMES - 1 do
		if t >= FRAMES[i].t and t <= FRAMES[i + 1].t then
			a, b = FRAMES[i], FRAMES[i + 1]
			break
		end
	end
	local span = b.t - a.t
	local k = span > 0 and math.clamp((t - a.t) / span, 0, 1) or 1
	k = ease(b.e, k)
	return a[key] + (b[key] - a[key]) * k
end

local function sample(t)
	local out = {}
	for _, key in ipairs(KEYS) do
		out[key] = channel(key, t - LAG[key])
	end
	return out
end

local joints, parts, origC0 = nil, nil, {}
local groundRel = 0

local function grab(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local torso = character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	local ra, la = character:FindFirstChild("Right Arm"), character:FindFirstChild("Left Arm")
	local rl, ll = character:FindFirstChild("Right Leg"), character:FindFirstChild("Left Leg")
	if not (hrp and torso and head and ra and la and rl and ll) then return nil end
	local j = {
		root = hrp:FindFirstChild("RootJoint"),
		neck = torso:FindFirstChild("Neck"),
		rs = torso:FindFirstChild("Right Shoulder"),
		ls = torso:FindFirstChild("Left Shoulder"),
		rh = torso:FindFirstChild("Right Hip"),
		lh = torso:FindFirstChild("Left Hip"),
	}
	for _, m in pairs(j) do
		if not m then return nil end
	end
	return j, { torso = torso, head = head, rs = ra, ls = la, rh = rl, lh = ll }
end

local function buildC0(v)
	return {
		root = CFrame.new(0, v.lift, 0) * rotated(origC0.root, A(v.lean, v.twist, v.roll)),
		neck = rotated(origC0.neck, A(v.head)),
		rh = CFrame.new(LEG_GAP, 0, 0) * rotated(origC0.rh, A(v.rLeg, 0, v.rSpr)),
		lh = CFrame.new(-LEG_GAP, 0, 0) * rotated(origC0.lh, A(v.lLeg, 0, -v.lSpr)),
		rs = rotated(origC0.rs, A(v.rsP, 0, v.rsR)),
		ls = rotated(origC0.ls, A(v.lsP, 0, -v.lsR)),
	}
end

local function lowestPoint(c0)
	local torsoCF = c0.root * joints.root.C1:Inverse()
	local lowest = math.huge
	local function scan(cf, size)
		for sx = -1, 1, 2 do
			for sy = -1, 1, 2 do
				for sz = -1, 1, 2 do
					local y = (cf * CFrame.new(sx * size.X / 2, sy * size.Y / 2, sz * size.Z / 2)).Position.Y
					if y < lowest then lowest = y end
				end
			end
		end
	end
	scan(torsoCF, parts.torso.Size)
	scan(torsoCF * c0.neck * joints.neck.C1:Inverse(), parts.head.Size)
	for _, name in ipairs({ "rs", "ls", "rh", "lh" }) do
		scan(torsoCF * c0[name] * joints[name].C1:Inverse(), parts[name].Size)
	end
	return lowest
end

local REST = {}
for _, k in ipairs(KEYS) do REST[k] = 0 end

local function apply(v, onJoint)
	local c0 = buildC0(v)
	local low = lowestPoint(c0)
	if low < groundRel then
		v.lift = v.lift + (groundRel - low)
		c0 = buildC0(v)
	end
	for name, cf in pairs(c0) do
		if name ~= "root" then joints[name].C0 = cf end
	end
	if onJoint then joints.root.C0 = c0.root end
	return c0.root * origC0.root:Inverse()
end

