local function characterModel(part)
	local m = part
	while m and m ~= workspace do
		if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then return m end
		m = m.Parent
	end
	return nil
end

local function killNPC(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function() hum.Health = 0 end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
	end
	pcall(function() model:BreakJoints() end)
end

local function partsOf(model)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(list, d) end
	end
	return list
end

local function scanTargets(character, root)
	local dir = flingDir
	if dir.Magnitude < 0.01 then return end
	local pos = root.Position
	local box = CFrame.lookAt(pos, pos + dir) * CFrame.new(0, 0, -HIT_FORWARD)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { character }
	local push = dir * TARGET_FLING_POWER + Vector3.new(0, TARGET_FLING_POWER * 0.5, 0)
	for _, part in ipairs(workspace:GetPartBoundsInBox(box, HIT_BOX, op)) do
		local model = characterModel(part)
		if model then
			if model ~= character and not Players:GetPlayerFromCharacter(model) and not hitModels[model] then
				killNPC(model)
				hitModels[model] = {
					parts = partsOf(model),
					t = tick(),
					time = NPC_PUSH_TIME,
					push = dir * NPC_PUSH_POWER + Vector3.new(0, NPC_PUSH_UP, 0),
					spin = Vector3.zero,
				}
			end
		else
			local assembly = part.AssemblyRootPart
			if assembly and not assembly.Anchored and not hitParts[assembly]
				and part.Size.Magnitude <= MAX_PART_SIZE then
				hitParts[assembly] = { t = tick(), time = TARGET_FLING_TIME, push = push, spin = Vector3.new(80, 120, 80) }
			end
		end
	end
end

local function applyTargetFling()
	local now = tick()
	for _, info in pairs(hitModels) do
		if now - info.t < info.time then
			for _, p in ipairs(info.parts) do
				if p.Parent then
					p.AssemblyLinearVelocity = info.push
					p.AssemblyAngularVelocity = info.spin
				end
			end
		end
	end
	for part, info in pairs(hitParts) do
		if now - info.t < info.time and part.Parent then
			part.AssemblyLinearVelocity = info.push
			part.AssemblyAngularVelocity = info.spin
		end
	end
end

local function targetsOff()
	playerNear = false
	if targetConn then targetConn:Disconnect() targetConn = nil end
	hitModels, hitParts = {}, {}
end

local function targetsOn(character, root)
	targetsOff()
	targetConn = RunService.Heartbeat:Connect(function()
		setSimRadius()
		playerNear = false
		if flinging and root.Parent then
			scanTargets(character, root)
			local pos = root.Position
			for _, pl in ipairs(Players:GetPlayers()) do
				local c = pl ~= player and pl.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				if r and (r.Position - pos).Magnitude <= PLAYER_FLING_RANGE then
					playerNear = true
					break
				end
			end
		end
		applyTargetFling()
	end)
end

local function disconnectAll()
	flinging = false
	if diedConn then diedConn:Disconnect() diedConn = nil end
	if flingConn then flingConn:Disconnect() flingConn = nil end
	noclipOff()
	targetsOff()
	if emoteTrack then
		local track = emoteTrack
		emoteTrack = nil
		pcall(function() track:Stop(0.1) end)
	end
	if active then
		pcall(function() RunService:UnbindFromRenderStep(STEP_NAME) end)
	end
	active = false
end

local function restore()
	if joints then
		for k, m in pairs(joints) do
			if m and m.Parent and origC0[k] then m.C0 = origC0[k] end
		end
	end
	if humanoidRef and humanoidRef.Parent then
		humanoidRef.WalkSpeed = saved.walk
		humanoidRef.JumpPower = saved.jumpPower
		humanoidRef.JumpHeight = saved.jumpHeight
		humanoidRef.AutoRotate = saved.autoRotate
		humanoidRef.PlatformStand = saved.platformStand
		humanoidRef.CameraOffset = saved.camOffset
	end
	if rootRef and rootRef.Parent and uprightCF then
		rootRef.CFrame = uprightCF
	end
	if rootRef and rootRef.Parent then
		rootRef.AssemblyLinearVelocity = Vector3.zero
		rootRef.AssemblyAngularVelocity = Vector3.zero
	end
	rootRef, uprightCF = nil, nil
	humanoidRef = nil
	if animateScript and animateScript.Parent then animateScript.Enabled = true end
	animateScript = nil
end

local function stop()
	disconnectAll()
	restore()
	joints, parts = nil, nil
	lastEnd = tick()
	setUI(false)
end

local TOTAL = 2.8

local function startEmote(character, humanoid)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local animId
	local gotObjects, result = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(R15_EMOTE_ID))
	end)
	if gotObjects and result and #result > 0 and result[1]:IsA("Animation") then
		animId = result[1].AnimationId
	else
		animId = "rbxassetid://" .. tostring(R15_EMOTE_ID)
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then
		warn("Dropkick: could not load the R15 emote.")
		return
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false

	local look = root.CFrame.LookVector
	local dashDir = Vector3.new(look.X, 0, look.Z)
	if dashDir.Magnitude > 0 then dashDir = dashDir.Unit end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	local filter = { character }
	params.FilterDescendantsInstances = filter
	local hit
	for _ = 1, 16 do
		hit = workspace:Raycast(root.Position, dashDir * (R15_DASH_DISTANCE + 3), params)
		if not hit then break end
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			table.insert(filter, model)
			params.FilterDescendantsInstances = filter
			hit = nil
		else
			break
		end
	end
	local dashMax = hit and math.max(0, hit.Distance - 3) or R15_DASH_DISTANCE
	local dashDone = 0
	flingDir = dashDir

	humanoidRef = nil
	rootRef = root
	emoteTrack = track
	diedConn = humanoid.Died:Connect(stop)

	local pulsed, lastVel = false, Vector3.zero
	flingConn = RunService.Heartbeat:Connect(function()
		if not flinging or not playerNear or not root.Parent then return end
		local look = root.CFrame.LookVector
		local d = Vector3.new(look.X, 0, look.Z)
		if d.Magnitude > 0 then d = d.Unit end
		lastVel = root.AssemblyLinearVelocity
		pulsed = true
		root.AssemblyLinearVelocity = d * FLING_POWER + Vector3.new(0, FLING_POWER, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, FLING_POWER, 0)
	end)

	noclipOn(character)
	targetsOn(character, root)
	active = true
	setUI(true)
	track:Play(0.1, 1, R15_EMOTE_SPEED)
	local t0 = tick()

	RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.First.Value, function()
		if not (root.Parent and humanoid.Parent) then stop() return end
		if pulsed then
			pulsed = false
			root.AssemblyLinearVelocity = lastVel
			root.AssemblyAngularVelocity = Vector3.zero
		end
		local dashT = tick() - t0 - R15_DASH_DELAY
		if dashT > 0 and dashDone < dashMax and dashDir.Magnitude > 0 then
			local k = math.clamp(dashT / R15_DASH_TIME, 0, 1)
			local want = dashMax * (1 - (1 - k) ^ 3)
			root.CFrame = root.CFrame + dashDir * (want - dashDone)
			dashDone = want
		end
		if tick() - t0 > 0.5 and not track.IsPlaying then stop() return end
		flinging = track.IsPlaying
	end)
end

local function start()
	if active or tick() - lastEnd < COOLDOWN then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		startEmote(character, humanoid)
		return
	end
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		warn("Dropkick: unsupported rig type.")
		return
	end
	local j, p = grab(character)
	if not j then
		warn("Dropkick: could not find R6 joints.")
		return
	end
	joints, parts = j, p
	for k, m in pairs(joints) do origC0[k] = m.C0 end
	groundRel = lowestPoint(buildC0(REST))

	animateScript = character:FindFirstChild("Animate")
	if animateScript then animateScript.Enabled = false end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
	end

	humanoidRef = humanoid
	saved = {
		walk = humanoid.WalkSpeed,
		jumpPower = humanoid.JumpPower,
		jumpHeight = humanoid.JumpHeight,
		autoRotate = humanoid.AutoRotate,
		platformStand = humanoid.PlatformStand,
		camOffset = humanoid.CameraOffset,
	}
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = false
	humanoid.PlatformStand = true

	diedConn = humanoid.Died:Connect(stop)

	local root = character.HumanoidRootPart
	local look = root.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z).Unit
	local origin = root.Position
	local groundY = origin.Y + groundRel
	local landed = false
	local control = false
	rootRef = root
	uprightCF = CFrame.lookAt(origin, origin + dir)
	flingDir = dir

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	local filter = { character }
	params.FilterDescendantsInstances = filter
	local hit
	for _ = 1, 16 do
		hit = workspace:Raycast(origin, dir * (DASH_DISTANCE + 3), params)
		if not hit then break end
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			table.insert(filter, model)
			params.FilterDescendantsInstances = filter
			hit = nil
		else
			break
		end
	end
	local maxDist = hit and math.max(0, hit.Distance - 3) or DASH_DISTANCE

	local vy = root.AssemblyLinearVelocity.Y
	local baseY = origin.Y
	local grounded = false
	local curGroundY = groundY
	local gFilter = { character }
	local gParams = RaycastParams.new()
	gParams.FilterType = Enum.RaycastFilterType.Exclude
	gParams.RespectCanCollide = true
	gParams.FilterDescendantsInstances = gFilter

	local function groundHeightAt(p)
		for _ = 1, 8 do
			local r = workspace:Raycast(p + Vector3.new(0, 1, 0), Vector3.new(0, -500, 0), gParams)
			if not r then return nil end
			local m = characterModel(r.Instance)
			if m then
				table.insert(gFilter, m)
				gParams.FilterDescendantsInstances = gFilter
			else
				return r.Position.Y
			end
		end
		return nil
	end

	local function travelled(t)
		if t <= LAUNCH_T then return 0 end
		local k = math.clamp((t - LAUNCH_T) / DASH_TIME, 0, 1)
		return maxDist * (1 - (1 - k) ^ 3)
	end

	flingConn = RunService.Heartbeat:Connect(function()
		if not flinging or not playerNear or not root.Parent then return end
		root.AssemblyLinearVelocity = flingDir * FLING_POWER + Vector3.new(0, FLING_POWER, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, FLING_POWER, 0)
	end)

	noclipOn(character)
	targetsOn(character, root)

	elapsed = 0
	active = true
	setUI(true)
	RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Camera.Value - 1, function(dt)
		if not (joints and joints.root.Parent and root.Parent) then stop() return end
		elapsed = elapsed + dt
		if elapsed >= TOTAL then stop() return end

		if not landed and elapsed >= LAND_T and grounded then
			landed = true
			local p2 = origin + dir * travelled(elapsed)
			dust(Vector3.new(p2.X, curGroundY + 0.1, p2.Z), 24)
		end

		if not control and elapsed >= GETUP_T then
			control = true
			flinging = false
			noclipOff()
			root.CFrame = uprightCF
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			uprightCF = nil
			humanoid.CameraOffset = saved.camOffset
			humanoid.PlatformStand = saved.platformStand
			humanoid.AutoRotate = saved.autoRotate
			humanoid.WalkSpeed = saved.walk * GETUP_WALK_SCALE
		end

		flinging = (not control) and elapsed >= FLING_FROM and elapsed < FLING_UNTIL

		if control then
			apply(sample(elapsed), true)
		else
			local delta = apply(sample(elapsed))
			local flat = origin + dir * travelled(elapsed)
			vy = vy - workspace.Gravity * dt
			baseY = baseY + vy * dt
			local gy = groundHeightAt(Vector3.new(flat.X, baseY, flat.Z))
			grounded = false
			if gy then
				curGroundY = gy
				if baseY <= gy - groundRel then
					baseY = gy - groundRel
					vy = 0
					grounded = true
				end
			end
			local pos = Vector3.new(flat.X, baseY, flat.Z)
			uprightCF = CFrame.lookAt(pos, pos + dir)
			root.CFrame = uprightCF * delta
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			local rc = root.CFrame
			local focus = pos + CAM_HEAD + uprightCF:VectorToWorldSpace(saved.camOffset)
			humanoid.CameraOffset = rc:VectorToObjectSpace(focus - rc.Position) - CAM_HEAD
		end
	end)
end

local function onAction(_, state)
	if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if active then stop() else start() end
	return Enum.ContextActionResult.Sink
end

ContextActionService:UnbindAction(ACTION_NAME)
ContextActionService:BindAction(ACTION_NAME, onAction, true, KEYBIND)
setUI(false)

player.CharacterAdded:Connect(function()
	disconnectAll()
	joints, parts, animateScript, humanoidRef, rootRef, uprightCF = nil, nil, nil, nil, nil, nil
	setUI(false)
end)

