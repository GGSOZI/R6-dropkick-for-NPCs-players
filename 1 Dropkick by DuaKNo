local function noclipOn(character)
	collideSaved = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then collideSaved[d] = d.CanCollide end
	end
	if noclipConn then noclipConn:Disconnect() end
	noclipConn = RunService.Stepped:Connect(function()
		for part in pairs(collideSaved) do
			if part.Parent then part.CanCollide = false end
		end
	end)
end

local function noclipOff()
	if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	for part, value in pairs(collideSaved) do
		if part.Parent then part.CanCollide = value end
	end
	collideSaved = {}
end

